# Copy this file to .env and fill in the values. NEVER upload .env to GitHub.

# Gmail account that SENDS the OTP emails
EMAIL_USER=yourproject@gmail.com
# 16-character Gmail App Password (not your normal Gmail password)
EMAIL_APP_PASSWORD=abcdefghijklmnop

# --- OR, if your host blocks SMTP (e.g. Render free plan), use Brevo's HTTPS API instead ---
# BREVO_API_KEY=xkeysib-xxxxxxxx
# BREVO_SENDER_EMAIL=the-sender-email-you-verified-in-brevo@gmail.com

# Any long random text (used to sign login sessions and hash OTPs)
SESSION_SECRET=change-this-to-a-long-random-string

# Set to production when deployed
# NODE_ENV=production

# Only if your host gives you a persistent disk, e.g. /data/foodbridge.db
# DB_PATH=
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

BREVO_API_KEY=your-api-key-here
BREVO_SENDER_EMAIL=your-verified-email
